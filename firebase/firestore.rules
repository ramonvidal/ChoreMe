rules_version = '2';

// Data model and the joining flow are described in PLAN.md.
// Access to a family is decided only by families/{f}/memberUids/{uid}, which only
// the family's creator (for themselves, at creation) or a parent can write.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function familyPath(f) {
      return /databases/$(database)/documents/families/$(f);
    }

    function membershipPath(f) {
      return /databases/$(database)/documents/families/$(f)/memberUids/$(request.auth.uid);
    }

    function isMember(f) {
      return signedIn() && exists(membershipPath(f));
    }

    function isParent(f) {
      return isMember(f) && get(membershipPath(f)).data.role == 'PARENT';
    }

    // True only inside the batch that creates family f, for its creator.
    function isCreatingFamily(f) {
      return signedIn()
        && !exists(familyPath(f))
        && getAfter(familyPath(f)).data.createdBy == request.auth.uid;
    }

    function validName(name) {
      return name is string && name.size() > 0 && name.size() <= 40;
    }

    function validGroceryItem(item) {
      return item.name is string && item.name.size() > 0 && item.name.size() <= 60
        && item.category is string && item.category.size() <= 30
        && item.isNeeded is bool
        && item.isStaple is bool
        && (!('listId' in item) || item.listId == null || (item.listId is string && item.listId.size() <= 40));
    }

    // "Away until" is a day (yyyy-MM-dd) or nothing.
    function validAway(d) {
      return !('awayUntil' in d) || d.awayUntil == null || (d.awayUntil is string && d.awayUntil.size() == 10);
    }

    function validNote(d, f) {
      return d.text is string && d.text.size() > 0 && d.text.size() <= 300
        && d.updatedAt is int;
    }

    function validSavedChore(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 60 && validPoints(d);
    }

    function myMemberId(f) {
      return get(membershipPath(f)).data.memberId;
    }

    function validChore(c) {
      return c.title is string && c.title.size() > 0 && c.title.size() <= 60
        && c.status in ['OPEN', 'CLAIMED', 'PENDING_APPROVAL', 'DONE']
        && c.recurrenceType in ['ONCE', 'EVERY_DAYS', 'WEEKLY']
        && c.dueDate is string && c.dueDate.size() == 10
        && (!('notifyWhenDone' in c) || c.notifyWhenDone is bool)
        && (!('urgent' in c) || c.urgent is bool)
        && validPoints(c)
        && (!('doneCount' in c) || (c.doneCount is int && c.doneCount >= 0));
    }

    // What a chore is worth: 1 for a quick job up to 5 for a big one.
    function validPoints(d) {
      return !('points' in d) || (d.points is int && d.points >= 1 && d.points <= 5);
    }

    function isFreshChore(c) {
      return c.status == 'OPEN' && c.claimedBy == null && c.completedBy == null
        && c.approvedBy == null && c.lastDoneBy == null
        // Kids report chores at the usual worth; parents decide what bigger jobs count.
        && (!('points' in c) || c.points == 1);
    }

    // Kids can grab an open chore, let go of one they hold, or say they finished it.
    // Finishing only ever sends it to a parent; kids never mark chores done themselves.
    function isKidChoreStep(f) {
      let before = resource.data;
      let after = request.resource.data;
      let me = myMemberId(f);
      return after.diff(before).affectedKeys().hasOnly(['status', 'claimedBy', 'completedBy', 'updatedAt', 'updatedBy'])
        && (
          (before.status == 'OPEN' && after.status == 'CLAIMED' && after.claimedBy == me)
          || (before.status == 'CLAIMED' && before.claimedBy == me && after.status == 'OPEN' && after.claimedBy == null)
          || (before.status in ['OPEN', 'CLAIMED'] && (before.claimedBy == null || before.claimedBy == me)
              && after.status == 'PENDING_APPROVAL' && after.claimedBy == me && after.completedBy == me)
        );
    }

    function validPoint(d) {
      return d.latitude is number && d.latitude >= -90 && d.latitude <= 90
        && d.longitude is number && d.longitude >= -180 && d.longitude <= 180;
    }

    function validLocation(d) {
      return validPoint(d) && d.accuracy is number && d.at is int;
    }

    function validPlace(d) {
      return validName(d.name) && validPoint(d) && d.radius is int && d.radius >= 50 && d.radius <= 2000;
    }

    // A device leaving a profile it shares with other devices (e.g. a kid's second tablet):
    // it may only take its own uid off the list.
    function isLeavingOwnProfile(f, memberId) {
      return isMember(f) && myMemberId(f) == memberId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uids'])
        && request.resource.data.uids == resource.data.uids.removeAll([request.auth.uid]);
    }

    // Pointer from a user to their family, for finding it again after signing in.
    // It grants nothing: access is checked against memberUids.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow create: if isCreatingFamily(request.resource.data.familyId)
        && getAfter(familyPath(request.resource.data.familyId)).data.inviteCode == code;
      // When the last person leaves, the family goes and its code with it.
      allow delete: if isParent(resource.data.familyId);
    }

    match /families/{f} {
      allow get: if isMember(f);
      allow create: if signedIn() && !isAnonymous()
        && request.resource.data.createdBy == request.auth.uid
        && validName(request.resource.data.name);
      allow update: if isParent(f)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.inviteCode == resource.data.inviteCode;
      allow delete: if isParent(f);

      match /memberUids/{uid} {
        allow get: if isMember(f) || (signedIn() && request.auth.uid == uid);
        allow list: if isMember(f);
        allow create: if isParent(f)
          || (isCreatingFamily(f) && uid == request.auth.uid
              && request.resource.data.role == 'PARENT'
              && request.resource.data.memberId == uid);
        // Parents remove anyone; everyone can leave (remove their own device).
        allow delete: if isParent(f) || (signedIn() && request.auth.uid == uid);
      }

      match /members/{memberId} {
        allow read: if isMember(f);
        allow create: if (isParent(f) || (isCreatingFamily(f) && memberId == request.auth.uid))
          && request.resource.data.role in ['PARENT', 'KID']
          && validName(request.resource.data.name);
        allow update: if (isParent(f) && validName(request.resource.data.name) && validAway(request.resource.data))
          || isLeavingOwnProfile(f, memberId)
          // Anyone can mark themselves away (or back); parents can do it for anyone above.
          || (isMember(f) && myMemberId(f) == memberId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['awayUntil'])
              && validAway(request.resource.data));
        allow delete: if isParent(f) || (isMember(f) && myMemberId(f) == memberId);
      }

      match /joinRequests/{uid} {
        allow get: if (signedIn() && request.auth.uid == uid) || isParent(f);
        allow list: if isParent(f);
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(familyPath(f))
          && !isMember(f)
          && validName(request.resource.data.name)
          && request.resource.data.role in ['PARENT', 'KID']
          && !(isAnonymous() && request.resource.data.role == 'PARENT');
        allow delete: if isParent(f) || (signedIn() && request.auth.uid == uid);
      }

      // Anyone who notices something needs doing can add it, in their own name. Kids add
      // it as a fresh, open chore and can take back only their own untouched reports.
      match /chores/{choreId} {
        allow read: if isMember(f);
        allow create: if isMember(f) && validChore(request.resource.data)
          && request.resource.data.createdBy == myMemberId(f)
          && (isParent(f) || isFreshChore(request.resource.data));
        allow update: if validChore(request.resource.data) && (isParent(f) || (isMember(f) && isKidChoreStep(f)));
        allow delete: if isParent(f)
          || (isMember(f) && resource.data.createdBy == myMemberId(f) && resource.data.status == 'OPEN');
      }

      // Shared only while someone chooses to; stopping deletes the document. Each phone
      // can only write the location of the member it belongs to.
      match /locations/{memberId} {
        allow read: if isMember(f);
        allow create, update: if isMember(f) && myMemberId(f) == memberId && validLocation(request.resource.data);
        allow delete: if isMember(f) && (myMemberId(f) == memberId || isParent(f));
      }

      // "Leo arrived at School", written by Leo's phone and picked up by the others.
      match /placeEvents/{eventId} {
        allow read: if isMember(f);
        allow create: if isMember(f) && request.resource.data.memberId == myMemberId(f)
          && request.resource.data.type in ['ARRIVED', 'LEFT']
          && validName(request.resource.data.placeName)
          && request.resource.data.at is int;
        allow delete: if isMember(f) && (resource.data.memberId == myMemberId(f) || isParent(f));
      }

      // Where to send a phone a wake-up ping (UnifiedPush, e.g. through the free ntfy app).
      // One per signed-in device; the ping itself carries no family data.
      match /pushEndpoints/{uid} {
        // Someone waiting to join may ping the family's phones, so parents see the request at once.
        allow read: if isMember(f)
          || (signedIn() && exists(/databases/$(database)/documents/families/$(f)/joinRequests/$(request.auth.uid)));
        allow create, update: if isMember(f) && request.auth.uid == uid
          && request.resource.data.memberId == myMemberId(f)
          && request.resource.data.url is string
          && request.resource.data.url.matches('https://.*')
          && request.resource.data.url.size() <= 500;
        allow delete: if (signedIn() && request.auth.uid == uid) || isParent(f);
      }

      match /places/{placeId} {
        allow read: if isMember(f);
        allow create, update: if isParent(f) && validPlace(request.resource.data);
        allow delete: if isParent(f);
      }

      // Chores someone typed by hand, kept as quick picks for next time.
      match /choreTemplates/{templateId} {
        allow read: if isMember(f);
        allow create: if isMember(f) && request.resource.data.createdBy == myMemberId(f)
          && validSavedChore(request.resource.data);
        // Whoever saved it, or a parent, can change its points.
        allow update: if isMember(f) && validSavedChore(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && (resource.data.createdBy == myMemberId(f) || isParent(f));
        allow delete: if isParent(f) || (isMember(f) && resource.data.createdBy == myMemberId(f));
      }

      // "Mom is at the shop", "Leo is on the way home": one document per person and kind,
      // named memberId_kind, so sharing again overwrites instead of piling up.
      match /announcements/{announcementId} {
        allow read: if isMember(f);
        allow create, update: if isMember(f)
          && request.resource.data.memberId == myMemberId(f)
          && request.resource.data.kind in ['SHOPPING', 'ON_MY_WAY']
          && announcementId == request.resource.data.memberId + '_' + request.resource.data.kind
          && request.resource.data.at is int;
        allow delete: if isMember(f) && (resource.data.memberId == myMemberId(f) || isParent(f));
      }

      // "Dinner's ready!": a message to everyone, sent in your own name. The sender tidies up
      // their old ones; parents can remove any.
      match /messages/{messageId} {
        allow read: if isMember(f);
        allow create: if isMember(f)
          && request.resource.data.from == myMemberId(f)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
          && request.resource.data.at is int;
        allow delete: if isParent(f) || (isMember(f) && resource.data.from == myMemberId(f));
      }

      // The family board. Anyone writes a note; the writer or a parent changes or removes it.
      match /notes/{noteId} {
        allow read: if isMember(f);
        allow create: if isMember(f) && request.resource.data.createdBy == myMemberId(f) && validNote(request.resource.data, f);
        allow update: if isMember(f) && validNote(request.resource.data, f)
          && request.resource.data.createdBy == resource.data.createdBy
          && (resource.data.createdBy == myMemberId(f) || isParent(f));
        allow delete: if isParent(f) || (isMember(f) && resource.data.createdBy == myMemberId(f));
      }

      // Each time a chore is finished, for "who did what this week". Finishing is a
      // parent's step (kids' chores are approved), so only parents write it.
      match /choreLog/{entryId} {
        allow read: if isMember(f);
        allow create: if isParent(f)
          && request.resource.data.choreId is string
          && request.resource.data.title is string && request.resource.data.title.size() <= 60
          && request.resource.data.doneBy is string
          && request.resource.data.on is string && request.resource.data.on.size() == 10
          && validPoints(request.resource.data);
        allow delete: if isParent(f);
      }

      // Lists besides groceries (pharmacy, packing...). Their items are groceryItems with a listId.
      match /lists/{listId} {
        allow read: if isMember(f);
        allow create: if isMember(f) && request.resource.data.createdBy == myMemberId(f) && validName(request.resource.data.name);
        allow update: if isMember(f) && validName(request.resource.data.name)
          && request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isParent(f) || (isMember(f) && resource.data.createdBy == myMemberId(f));
      }

      // Everyone in the family, kids included, can say "we're out of eggs".
      match /groceryItems/{itemId} {
        allow read, delete: if isMember(f);
        allow create, update: if isMember(f) && validGroceryItem(request.resource.data);
      }
    }
  }
}
